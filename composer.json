{
  "name": "koutendb/koutendb",
  "description": "PHP FFI driver for KoutenDB",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/puffball1567/koutendb",
  "keywords": [
    "koutendb",
    "database",
    "nosql",
    "ffi",
    "rag",
    "retrieval"
  ],
  "support": {
    "source": "https://github.com/puffball1567/koutendb-php",
    "issues": "https://github.com/puffball1567/koutendb-php/issues"
  },
  "require": {
    "php": ">=8.2",
    "ext-ffi": "*"
  },
  "autoload": {
    "psr-4": {
      "KoutenDB\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KoutenDB\\Tests\\": "tests/"
    }
  }
}
